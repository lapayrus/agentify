{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentify",
  "version": "0.2.0",
  "identifier": "dev.agentify.shell",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build && npm run stage:sidecar",
    "beforeBuildCommand": "npm run build && npm run stage:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agentify",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Agentify",
    "copyright": "Copyright (c) Agentify contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local, agent-native environment manager",
    "longDescription": "Agentify runs each Project in its own isolated local runtime and exposes it to agents and humans through one loopback control plane. The installer is per user and needs no administrator rights.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/agentifyd", "binaries/agentify-mcp", "binaries/agentify"],
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDODQ4OTI4ODE5NUIyNzUKUldSMXNwV0JLSW1FL0p5NmpqVGJmdElqbm1jMjc2NEhiYTNqWTlJWDdLaDBjQzFuYWU4azFjbmUK",
      "endpoints": [
        "https://github.com/lapayrus/agentify/releases/latest/download/latest.json"
      ]
    }
  }
}
